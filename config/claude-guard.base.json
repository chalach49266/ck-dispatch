    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Read(~/.grokbot/**)",
      "Read(~/.tidy3d/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/**/auth*)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*auth*.json)",
      "Read(**/*credential*)",
      "Bash(security:*)",
      "Bash(env)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(git push:*)",
      "Bash(git clone:*)",
      "Bash(gh:*)",
      "Bash(wrangler:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
