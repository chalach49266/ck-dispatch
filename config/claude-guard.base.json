      "Bash(mail:*)",
      "Bash(sendmail:*)",
      "Bash(python -m venv:*)",
      "Bash(python3 -m venv:*)",
      "Bash(virtualenv:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci:*)",
      "Bash(uv venv:*)",
      "Bash(uv pip install:*)",
      "Bash(conda create:*)",
      "Bash(conda install:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
