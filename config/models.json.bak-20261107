  "_verified": {
    "checked_at": "2026-11-05T23:13:10-06:00",
    "how": "read only: --help texts, agent --list-models (it only lists), strings of the installed CLI binaries, ~/.codex/config.toml. No agent prompt, no codex exec.",
    "claude": {
      "cli": "claude 2.1.318",
      "model_flag": "--model <alias or full name>",
      "models": ["opus", "sonnet", "haiku"],
