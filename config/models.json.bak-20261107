    "decision":   {"worker": "race",     "also": [],                     "check": null},
    "loop":       {"worker": "sol-fast", "also": ["composer", "sonnet"], "check": "astra"},
    "repo":       {"worker": "sol",      "also": ["astra"],              "check": "opus"},
    "scout":      {"worker": "grok",     "also": ["sol"],                "check": "opus"},
    "mechanical": {"worker": "composer", "also": ["gemini"],             "check": null}
