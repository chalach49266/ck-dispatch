#!/usr/bin/env python3
"""ck-run: CK's single runner for claude, codex, cursor (agent) and agy. See ../README.md."""
import os
import sys

if not sys.flags.isolated:  # always run isolated (-I): no user site-packages, no script-dir imports
    os.execv(sys.executable, [sys.executable, "-I", os.path.realpath(__file__)] + sys.argv[1:])

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from ckdispatch.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
