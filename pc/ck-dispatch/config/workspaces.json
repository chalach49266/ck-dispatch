{
  "version": 1,
  "onedrive_root": "{{ONEDRIVE_ROOT}}",
  "local_root": "~/PhD_local",
  "runs_dir": "~/PhD_local/agent_runs",
  "local_protected": [
    "ck-dispatch",
    "agent_runs",
    "grok-bot-agents",
    "Device Fabrication",
    "NV Compact Magnetometer"
  ],
  "bin_dirs": [
    "~/.local/bin",
    "/usr/local/bin",
    "/usr/bin",
    "/bin",
    "/usr/sbin",
    "/sbin"
  ],
  "default_timeout_s": 1200,
  "max_timeout_s": 14400,
  "scan_budget_s": 120,
  "scan_max_entries": 1000000,
  "live": {
    "default": true,
    "terminal": "iTerm2",
    "osascript": "~/PhD_local/ck-dispatch/platform/auto/osascript",
    "caffeinate": "{{WSL_HOME}}/PhD_local/ck-dispatch/platform/wsl/caffeinate",
    "start_timeout_s": 30,
    "early_exit_s": 20,
    "poll_s": 1.0,
    "watchdog": true,
    "stall_s": 300,
    "keep_awake": true,
    "close_tab_after_s": 300
  },
  "post_review": {
    "enabled": false,
    "timeout_s": 300
  },
  "asks": {
    "required": true,
    "budgets": {
      "S": {
        "runs": 1,
        "parallel": 1,
        "reviews": 0,
        "fixes": 0,
        "wall_min": 15,
        "timeout_s": 600,
        "stall_s": 180
      },
      "M": {
        "runs": 2,
        "parallel": 1,
        "reviews": 1,
        "fixes": 1,
        "wall_min": 45,
        "timeout_s": 1800,
        "stall_s": 300
      },
      "L": {
        "runs": 6,
        "parallel": 3,
        "reviews": 2,
        "fixes": 2,
        "wall_min": 180,
        "timeout_s": 7200,
        "stall_s": 480
      }
    }
  },
